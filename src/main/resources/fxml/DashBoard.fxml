<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.controller.DashboardController"
            styleClass="fondo-principal"
            stylesheets="@../css/main.css">

    <left>
        <VBox styleClass="menu-lateral" spacing="4">
            <padding><Insets top="24" right="12" bottom="24" left="12"/></padding>
            <VBox alignment="CENTER_LEFT" spacing="2">
                <padding><Insets bottom="28"/></padding>
                <Label text="🚗 BAEMIMPORT" styleClass="menu-logo"/>
                <Label text="Importación desde Alemania" styleClass="menu-logo-sub"/>
            </VBox>
            <Label text="MENÚ" style="-fx-font-size:10px; -fx-text-fill:#4f6ef7; -fx-padding:0 0 6 8;"/>
            <Button fx:id="btnDashboard"     text="📊  Dashboard"       styleClass="btn-nav, btn-nav-activo" maxWidth="Infinity" onAction="#irDashboard"/>
            <Button fx:id="btnVehiculos"     text="🚙  Mis Vehículos"   styleClass="btn-nav" maxWidth="Infinity" onAction="#irGestionVehiculos"/>
            <Button fx:id="btnBusqueda"      text="🔍  Buscar Vehículo" styleClass="btn-nav" maxWidth="Infinity" onAction="#irBusqueda"/>
            <Button fx:id="btnFaseAlemania"  text="🇩🇪  Fase Alemania"  styleClass="btn-nav" maxWidth="Infinity" onAction="#irFaseAlemania"/>
            <Button fx:id="btnTransporte"    text="🚛  Transporte"       styleClass="btn-nav" maxWidth="Infinity" onAction="#irTransporte"/>
            <Button fx:id="btnFaseEspana"    text="🇪🇸  Fase España"    styleClass="btn-nav" maxWidth="Infinity" onAction="#irFaseEspana"/>
            <Button fx:id="btnDocumentos"    text="📁  Documentos"       styleClass="btn-nav" maxWidth="Infinity" onAction="#irDocumentos"/>
            <Separator styleClass="separador"/>
            <Button fx:id="btnPerfil"        text="👤  Mi Perfil"        styleClass="btn-nav" maxWidth="Infinity" onAction="#irPerfil"/>
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll-pane">
            <VBox spacing="24">
                <padding><Insets top="32" right="32" bottom="32" left="32"/></padding>

                <HBox alignment="CENTER_LEFT" spacing="12">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Dashboard" styleClass="titulo-pagina"/>
                        <Label fx:id="lblBienvenida" text="Bienvenido de nuevo" styleClass="subtitulo"/>
                    </VBox>
                    <Button fx:id="btnNotificaciones" text="🔔  Notificaciones"
                            styleClass="btn-secundario" onAction="#abrirNotificaciones"/>
                </HBox>

                <!-- Tarjetas resumen -->
                <HBox spacing="16">
                    <VBox styleClass="tarjeta" spacing="8" HBox.hgrow="ALWAYS">
                        <Label text="🚗  Importaciones activas" styleClass="etiqueta-campo"/>
                        <Label fx:id="lblTotalVehiculos" text="0" style="-fx-font-size:32px; -fx-font-weight:bold; -fx-text-fill:#4f6ef7;"/>
                        <Label text="vehículos en proceso" styleClass="texto-secundario"/>
                    </VBox>
                    <VBox styleClass="tarjeta" spacing="8" HBox.hgrow="ALWAYS">
                        <Label text="📄  Documentos pendientes" styleClass="etiqueta-campo"/>
                        <Label fx:id="lblDocsPendientes" text="0" style="-fx-font-size:32px; -fx-font-weight:bold; -fx-text-fill:#ef4444;"/>
                        <Label text="por subir o completar" styleClass="texto-secundario"/>
                    </VBox>
                    <VBox styleClass="tarjeta" spacing="8" HBox.hgrow="ALWAYS">
                        <Label text="📊  Progreso global" styleClass="etiqueta-campo"/>
                        <Label fx:id="lblPorcentaje" text="0%" style="-fx-font-size:32px; -fx-font-weight:bold; -fx-text-fill:#22c55e;"/>
                        <ProgressBar fx:id="barraProgreso" progress="0.0"
                                     styleClass="barra-progreso" maxWidth="Infinity"/>
                    </VBox>
                </HBox>

                <!-- Vehículo activo -->
                <VBox styleClass="tarjeta" spacing="16">
                    <Label text="Importación en curso" styleClass="titulo-seccion"/>
                    <Separator styleClass="separador"/>
                    <HBox spacing="24" alignment="CENTER_LEFT">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label fx:id="lblVehiculo" text="Selecciona un vehículo"
                                   style="-fx-font-size:16px; -fx-font-weight:bold; -fx-text-fill:#e8eaf0;"/>
                            <Label fx:id="lblEstadoVehiculo" text="Sin importación activa" styleClass="badge-pendiente"/>
                        </VBox>
                        <VBox spacing="4" alignment="CENTER">
                            <Label text="Fase actual" styleClass="etiqueta-campo"/>
                            <Label fx:id="lblFaseActual" text="—" styleClass="texto-primario"
                                   style="-fx-font-size:15px;"/>
                        </VBox>
                    </HBox>

                    <!-- Línea de fases -->
                    <HBox spacing="0" alignment="CENTER">
                        <VBox alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="🇩🇪" style="-fx-font-size:22px;"/>
                            <Label text="Alemania" styleClass="texto-secundario"/>
                            <Label fx:id="estadoAlemania" text="Pendiente" styleClass="badge-pendiente"/>
                        </VBox>
                        <Label text="──────" style="-fx-text-fill:#2e3148;"/>
                        <VBox alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="🚛" style="-fx-font-size:22px;"/>
                            <Label text="Transporte" styleClass="texto-secundario"/>
                            <Label fx:id="estadoTransporte" text="Pendiente" styleClass="badge-pendiente"/>
                        </VBox>
                        <Label text="──────" style="-fx-text-fill:#2e3148;"/>
                        <VBox alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="🇪🇸" style="-fx-font-size:22px;"/>
                            <Label text="España" styleClass="texto-secundario"/>
                            <Label fx:id="estadoEspana" text="Pendiente" styleClass="badge-pendiente"/>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- Tareas pendientes -->
                <VBox styleClass="tarjeta" spacing="12">
                    <Label text="⚠️  Tareas pendientes" styleClass="titulo-seccion"/>
                    <Separator styleClass="separador"/>
                    <VBox fx:id="listaTareas" spacing="8"/>
                    <Label fx:id="lblSinTareas" text="✅ Todo al día, sin tareas pendientes."
                           styleClass="texto-secundario" visible="false"/>
                </VBox>

                <!-- Acciones rápidas -->
                <VBox styleClass="tarjeta" spacing="12">
                    <Label text="⚡  Acciones rápidas" styleClass="titulo-seccion"/>
                    <Separator styleClass="separador"/>
                    <HBox spacing="12">
                        <Button text="+ Nueva importación" styleClass="btn-primario"   onAction="#irGestionVehiculos"/>
                        <Button text="📋 Ver checklist"    styleClass="btn-secundario" onAction="#irFaseAlemania"/>
                        <Button text="📁 Mis documentos"   styleClass="btn-secundario" onAction="#irDocumentos"/>
                    </HBox>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>