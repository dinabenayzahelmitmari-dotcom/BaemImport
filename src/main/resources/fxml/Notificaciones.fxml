<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.controller.NotificacionController"
            styleClass="fondo-principal"
            stylesheets="@../css/main.css">

    <left>
        <VBox styleClass="menu-lateral" spacing="4">
            <padding><Insets top="24" right="12" bottom="24" left="12"/></padding>
            <VBox alignment="CENTER_LEFT" spacing="2">
                <padding><Insets bottom="28"/></padding>
                <Label text="BAEMIMPORT" styleClass="menu-logo"/>
                <Label text="Importacion desde Alemania" styleClass="menu-logo-sub"/>
            </VBox>
            <Label text="MENU" style="-fx-font-size:10px; -fx-text-fill:#4f6ef7; -fx-padding:0 0 6 8;"/>
            <Button text="Dashboard"       styleClass="btn-nav" maxWidth="Infinity" onAction="#irDashboard"/>
            <Button text="Mis Vehiculos"   styleClass="btn-nav" maxWidth="Infinity" onAction="#irVehiculos"/>
            <Button text="Buscar Vehiculo" styleClass="btn-nav" maxWidth="Infinity" onAction="#irBusqueda"/>
            <Button text="Fase Alemania"   styleClass="btn-nav" maxWidth="Infinity" onAction="#irFaseAlemania"/>
            <Button text="Transporte"      styleClass="btn-nav" maxWidth="Infinity" onAction="#irTransporte"/>
            <Button text="Fase Espana"     styleClass="btn-nav" maxWidth="Infinity" onAction="#irFaseEspana"/>
            <Button text="Documentos"      styleClass="btn-nav" maxWidth="Infinity" onAction="#irDocumentos"/>
            <Separator styleClass="separador"/>
            <Button text="Mi Perfil"       styleClass="btn-nav" maxWidth="Infinity" onAction="#irPerfil"/>
            <Button text="Notificaciones" maxWidth="Infinity">
                <styleClass>
                    <String fx:value="btn-nav"/>
                    <String fx:value="btn-nav-activo"/>
                </styleClass>
            </Button>
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll-pane">
            <VBox spacing="24">
                <padding><Insets top="32" right="32" bottom="32" left="32"/></padding>

                <HBox alignment="CENTER_LEFT" spacing="12">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Centro de Notificaciones" styleClass="titulo-pagina"/>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label text="Alertas y avisos del sistema" styleClass="subtitulo"/>
                            <Label fx:id="lblTotalNoLeidas" text="0 sin leer" styleClass="badge-en-proceso"/>
                        </HBox>
                    </VBox>
                </HBox>

                <!-- Lista de notificaciones -->
                <VBox styleClass="tarjeta" spacing="12">
                    <Label text="Notificaciones recientes" styleClass="titulo-seccion"/>
                    <Separator styleClass="separador"/>
                    <VBox fx:id="listaNotificaciones" spacing="10"/>
                </VBox>

                <!-- Enviar correo -->
                <VBox styleClass="tarjeta" spacing="16">
                    <Label text="Enviar notificacion por correo" styleClass="titulo-seccion"/>
                    <Separator styleClass="separador"/>

                    <HBox spacing="16">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="CORREO DESTINATARIO" styleClass="etiqueta-campo"/>
                            <TextField fx:id="campoEmailDestino" styleClass="campo-texto"
                                       promptText="correo@ejemplo.com"/>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="TIPO DE NOTIFICACION" styleClass="etiqueta-campo"/>
                            <ComboBox fx:id="comboTipoNotificacion" styleClass="combo-box"
                                      maxWidth="Infinity"/>
                        </VBox>
                    </HBox>

                    <VBox spacing="6">
                        <Label text="MENSAJE PERSONALIZADO (opcional)" styleClass="etiqueta-campo"/>
                        <TextArea fx:id="campoMensajePersonalizado" styleClass="campo-texto"
                                  promptText="Escribe aqui un mensaje adicional..."
                                  prefRowCount="4" wrapText="true"/>
                    </VBox>

                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Button text="Enviar correo" styleClass="btn-primario"
                                onAction="#enviarNotificacionCorreo"/>
                        <Label fx:id="lblResultadoEnvio" text="" styleClass="texto-normal"/>
                    </HBox>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
