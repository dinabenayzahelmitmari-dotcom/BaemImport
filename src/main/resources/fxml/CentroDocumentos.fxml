<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.controller.CentroDocumentosController"
            styleClass="fondo-principal"
            stylesheets="@../css/main.css">
    <left>
        <VBox styleClass="menu-lateral" spacing="4">
            <padding><Insets top="24" right="12" bottom="24" left="12"/></padding>
            <VBox alignment="CENTER_LEFT" spacing="2"><padding><Insets bottom="28"/></padding>
                <Label text="BAEMIMPORT" styleClass="menu-logo"/>
                <Label text="Importacion desde Alemania" styleClass="menu-logo-sub"/>
            </VBox>
            <Label text="MENU" style="-fx-font-size:10px; -fx-text-fill:#4f6ef7; -fx-padding:0 0 6 8;"/>
            <Button text="Dashboard"       styleClass="btn-nav" maxWidth="Infinity" onAction="#irDashboard"/>
            <Button text="Mis Vehiculos"   styleClass="btn-nav" maxWidth="Infinity" onAction="#irVehiculos"/>
            <Button text="Buscar Vehiculo" styleClass="btn-nav" maxWidth="Infinity" onAction="#irBusqueda"/>
            <Button text="Fase Alemania"   styleClass="btn-nav" maxWidth="Infinity" onAction="#irFaseAlemania"/>
            <Button text="Transporte"      styleClass="btn-nav" maxWidth="Infinity" onAction="#irTransporte"/>
            <Button text="Fase Espana"     styleClass="btn-nav" maxWidth="Infinity" onAction="#irFaseEspana"/>
            <Button text="Documentos" maxWidth="Infinity">
                <styleClass>
                    <String fx:value="btn-nav"/>
                    <String fx:value="btn-nav-activo"/>
                </styleClass>
            </Button>
            <Separator styleClass="separador"/>
            <Button text="Mi Perfil"       styleClass="btn-nav" maxWidth="Infinity" onAction="#irPerfil"/>
        </VBox>
    </left>
    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll-pane">
            <VBox spacing="24"><padding><Insets top="32" right="32" bottom="32" left="32"/></padding>

                <HBox alignment="CENTER_LEFT">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Centro de Documentos" styleClass="titulo-pagina"/>
                        <Label text="Gestiona toda la documentacion de tus importaciones" styleClass="subtitulo"/>
                    </VBox>
                </HBox>

                <!-- Filtros -->
                <VBox styleClass="tarjeta" spacing="12">
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <TextField fx:id="campoBusquedaDoc" styleClass="campo-texto"
                                   promptText="Buscar documento..." HBox.hgrow="ALWAYS"
                                   onKeyReleased="#filtrarDocumentos"/>
                        <ComboBox fx:id="comboFiltroFase" styleClass="combo-box"
                                  promptText="Fase" prefWidth="180" onAction="#filtrarDocumentos"/>
                        <ComboBox fx:id="comboFiltroTipo" styleClass="combo-box"
                                  promptText="Tipo" prefWidth="120" onAction="#filtrarDocumentos"/>
                        <Button text="Limpiar filtros" styleClass="btn-secundario" onAction="#limpiarFiltros"/>
                    </HBox>

                    <TableView fx:id="tablaDocumentos" prefHeight="300" styleClass="table-view">
                        <columns>
                            <TableColumn fx:id="colNombre"   text="NOMBRE"    prefWidth="200"/>
                            <TableColumn fx:id="colFase"     text="FASE"      prefWidth="150"/>
                            <TableColumn fx:id="colTipo"     text="TIPO"      prefWidth="80"/>
                            <TableColumn fx:id="colVehiculo" text="VEHICULO"  prefWidth="160"/>
                            <TableColumn fx:id="colFecha"    text="FECHA"     prefWidth="110"/>
                            <TableColumn fx:id="colEstado"   text="ESTADO"    prefWidth="110"/>
                        </columns>
                        <placeholder><Label text="Sin documentos." styleClass="texto-secundario"/></placeholder>
                    </TableView>

                    <Label fx:id="lblInfoSeleccion" text="" styleClass="texto-secundario"/>
                </VBox>

                <!-- Acciones -->
                <VBox styleClass="tarjeta" spacing="12">
                    <Label text="Acciones" styleClass="titulo-seccion"/>
                    <Separator styleClass="separador"/>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Button text="Subir documento"      styleClass="btn-primario"   onAction="#subirNuevoDocumento"/>
                        <Button text="Ver documento"        styleClass="btn-secundario" onAction="#verDocumento"/>
                        <Button text="Descargar documento"  styleClass="btn-secundario" onAction="#descargarDocumento"/>
                        <Button text="Descargar informe PDF" styleClass="btn-exito"    onAction="#descargarInformePdf"/>
                        <Button text="Eliminar"             styleClass="btn-peligro"   onAction="#eliminarDocumento"/>
                    </HBox>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
