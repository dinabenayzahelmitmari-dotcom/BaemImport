<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<HBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.controller.LoginController"
      stylesheets="@../css/main.css"
      styleClass="fondo-principal"
      prefWidth="900" prefHeight="600">

    <!-- Panel izquierdo: marca -->
    <VBox styleClass="panel-login-marca" alignment="CENTER" spacing="16" prefWidth="380">
        <padding><Insets top="60" right="50" bottom="60" left="50"/></padding>
        <Label text="BAEMIMPORT" styleClass="login-logo"/>
        <Label text="Gestion de importacion de vehiculos desde Alemania"
               styleClass="login-logo-sub" wrapText="true" textAlignment="CENTER"/>
        <Separator styleClass="separador" maxWidth="120"/>
        <VBox spacing="10" alignment="CENTER">
            <Label text="Importacion profesional" styleClass="login-feature"/>
            <Label text="Gestion documental completa" styleClass="login-feature"/>
            <Label text="Calculo de impuestos automatico" styleClass="login-feature"/>
            <Label text="Notificaciones por correo" styleClass="login-feature"/>
        </VBox>
    </VBox>

    <!-- Panel derecho: formularios -->
    <VBox HBox.hgrow="ALWAYS" alignment="CENTER" styleClass="panel-login-form">
        <padding><Insets top="50" right="60" bottom="50" left="60"/></padding>

        <!-- Panel Login -->
        <VBox fx:id="panelLogin" spacing="20" maxWidth="380" alignment="CENTER_LEFT">
            <Label text="Iniciar sesion" styleClass="titulo-pagina"/>
            <Label text="Accede a tu cuenta de BAEMIMPORT" styleClass="subtitulo"/>

            <VBox spacing="6">
                <Label text="CORREO ELECTRONICO" styleClass="etiqueta-campo"/>
                <TextField fx:id="campoEmailLogin" styleClass="campo-texto"
                           promptText="correo@ejemplo.com" maxWidth="Infinity"/>
            </VBox>

            <VBox spacing="6">
                <Label text="CONTRASENA" styleClass="etiqueta-campo"/>
                <PasswordField fx:id="campoPasswordLogin" styleClass="campo-texto"
                               promptText="Tu contrasena" maxWidth="Infinity"/>
            </VBox>

            <Label fx:id="lblErrorLogin" text="" styleClass="texto-error" wrapText="true"/>

            <Button text="Entrar" styleClass="btn-primario" maxWidth="Infinity"
                    onAction="#iniciarSesion"/>

            <HBox alignment="CENTER" spacing="8">
                <Label text="No tienes cuenta?" styleClass="texto-secundario"/>
                <Button text="Registrate aqui" styleClass="btn-link" onAction="#mostrarRegistro"/>
            </HBox>

            <Separator styleClass="separador"/>
            <VBox spacing="4" alignment="CENTER">
                <Label text="Acceso de demostracion" styleClass="etiqueta-campo"/>
                <Label text="demo@baemimport.com / demo123" styleClass="texto-demo"/>
            </VBox>
        </VBox>

        <!-- Panel Registro -->
        <VBox fx:id="panelRegistro" spacing="18" maxWidth="380" alignment="CENTER_LEFT"
              visible="false" managed="false">
            <Label text="Crear cuenta" styleClass="titulo-pagina"/>
            <Label text="Registrate para empezar a importar" styleClass="subtitulo"/>

            <VBox spacing="6">
                <Label text="NOMBRE COMPLETO" styleClass="etiqueta-campo"/>
                <TextField fx:id="campoNombreRegistro" styleClass="campo-texto"
                           promptText="Tu nombre" maxWidth="Infinity"/>
            </VBox>

            <VBox spacing="6">
                <Label text="CORREO ELECTRONICO" styleClass="etiqueta-campo"/>
                <TextField fx:id="campoEmailRegistro" styleClass="campo-texto"
                           promptText="correo@ejemplo.com" maxWidth="Infinity"/>
            </VBox>

            <VBox spacing="6">
                <Label text="CONTRASENA" styleClass="etiqueta-campo"/>
                <PasswordField fx:id="campoPasswordRegistro" styleClass="campo-texto"
                               promptText="Minimo 6 caracteres" maxWidth="Infinity"/>
            </VBox>

            <VBox spacing="6">
                <Label text="CONFIRMAR CONTRASENA" styleClass="etiqueta-campo"/>
                <PasswordField fx:id="campoConfirmarPassword" styleClass="campo-texto"
                               promptText="Repite la contrasena" maxWidth="Infinity"/>
            </VBox>

            <Label fx:id="lblErrorRegistro" text="" styleClass="texto-error" wrapText="true"/>

            <Button text="Crear cuenta" styleClass="btn-primario" maxWidth="Infinity"
                    onAction="#registrarse"/>

            <HBox alignment="CENTER" spacing="8">
                <Label text="Ya tienes cuenta?" styleClass="texto-secundario"/>
                <Button text="Inicia sesion" styleClass="btn-link" onAction="#mostrarLogin"/>
            </HBox>
        </VBox>

    </VBox>

</HBox>
