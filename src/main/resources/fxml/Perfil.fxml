<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.controller.PerfilController"
            styleClass="fondo-principal"
            stylesheets="@../css/main.css">
    <left>
        <VBox styleClass="menu-lateral" spacing="4">
            <padding><Insets top="24" right="12" bottom="24" left="12"/></padding>
            <VBox alignment="CENTER_LEFT" spacing="2"><padding><Insets bottom="28"/></padding>
                <Label text="BAEMIMPORT" styleClass="menu-logo"/>
                <Label text="Importacion desde Alemania" styleClass="menu-logo-sub"/>
            </VBox>
            <Label text="MENU" style="-fx-font-size:10px; -fx-text-fill:#4f6ef7; -fx-padding:0 0 6 8;"/>
            <Button text="Dashboard"       styleClass="btn-nav" maxWidth="Infinity" onAction="#irDashboard"/>
            <Button text="Mis Vehiculos"   styleClass="btn-nav" maxWidth="Infinity" onAction="#irVehiculos"/>
            <Button text="Buscar Vehiculo" styleClass="btn-nav" maxWidth="Infinity" onAction="#irBusqueda"/>
            <Button text="Fase Alemania"   styleClass="btn-nav" maxWidth="Infinity" onAction="#irFaseAlemania"/>
            <Button text="Transporte"      styleClass="btn-nav" maxWidth="Infinity" onAction="#irTransporte"/>
            <Button text="Fase Espana"     styleClass="btn-nav" maxWidth="Infinity" onAction="#irFaseEspana"/>
            <Button text="Documentos"      styleClass="btn-nav" maxWidth="Infinity" onAction="#irDocumentos"/>
            <Separator styleClass="separador"/>
            <Button text="Mi Perfil" maxWidth="Infinity">
                <styleClass>
                    <String fx:value="btn-nav"/>
                    <String fx:value="btn-nav-activo"/>
                </styleClass>
            </Button>
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll-pane">
            <VBox spacing="24"><padding><Insets top="32" right="32" bottom="32" left="32"/></padding>

                <HBox alignment="CENTER_LEFT">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Mi Perfil" styleClass="titulo-pagina"/>
                        <Label text="Informacion personal y configuracion de cuenta" styleClass="subtitulo"/>
                    </VBox>
                </HBox>

                <!-- Datos personales -->
                <VBox styleClass="tarjeta" spacing="16">
                    <Label text="Datos personales" styleClass="titulo-seccion"/>
                    <Separator styleClass="separador"/>
                    <HBox spacing="16">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="NOMBRE COMPLETO" styleClass="etiqueta-campo"/>
                            <TextField fx:id="campoNombre" styleClass="campo-texto" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="DNI / NIE" styleClass="etiqueta-campo"/>
                            <TextField fx:id="campoDni" styleClass="campo-texto" maxWidth="Infinity"/>
                        </VBox>
                    </HBox>
                    <HBox spacing="16">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="CORREO ELECTRONICO" styleClass="etiqueta-campo"/>
                            <TextField fx:id="campoEmail" styleClass="campo-texto" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="TELEFONO" styleClass="etiqueta-campo"/>
                            <TextField fx:id="campoTelefono" styleClass="campo-texto" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="6">
                            <Label text="FECHA DE NACIMIENTO" styleClass="etiqueta-campo"/>
                            <DatePicker fx:id="fechaNacimiento" styleClass="campo-texto"/>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- Direccion -->
                <VBox styleClass="tarjeta" spacing="16">
                    <Label text="Direccion" styleClass="titulo-seccion"/>
                    <Separator styleClass="separador"/>
                    <VBox spacing="6">
                        <Label text="DIRECCION" styleClass="etiqueta-campo"/>
                        <TextField fx:id="campoDireccion" styleClass="campo-texto" maxWidth="Infinity"/>
                    </VBox>
                    <HBox spacing="16">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="CIUDAD" styleClass="etiqueta-campo"/>
                            <TextField fx:id="campoCiudad" styleClass="campo-texto" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="6">
                            <Label text="CODIGO POSTAL" styleClass="etiqueta-campo"/>
                            <TextField fx:id="campoCp" styleClass="campo-texto" prefWidth="120"/>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="PROVINCIA" styleClass="etiqueta-campo"/>
                            <TextField fx:id="campoProvincia" styleClass="campo-texto" maxWidth="Infinity"/>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- Datos bancarios y fiscales -->
                <VBox styleClass="tarjeta" spacing="16">
                    <Label text="Datos bancarios y fiscales" styleClass="titulo-seccion"/>
                    <Separator styleClass="separador"/>
                    <HBox spacing="16">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="BANCO" styleClass="etiqueta-campo"/>
                            <TextField fx:id="campoBanco" styleClass="campo-texto" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="IBAN" styleClass="etiqueta-campo"/>
                            <TextField fx:id="campoIban" styleClass="campo-texto" maxWidth="Infinity"
                                       promptText="ES00 0000 0000 0000 0000 0000"/>
                        </VBox>
                    </HBox>
                    <VBox spacing="6">
                        <Label text="DELEGACION DE HACIENDA" styleClass="etiqueta-campo"/>
                        <TextField fx:id="campoDelegacionHacienda" styleClass="campo-texto"
                                   promptText="Delegacion territorial de la AEAT" maxWidth="500"/>
                    </VBox>

                    <Label fx:id="lblMensaje" text="" styleClass="texto-normal"/>
                    <Button text="Guardar perfil" styleClass="btn-primario" onAction="#guardarPerfil"/>
                </VBox>

                <!-- Cambiar contrasena -->
                <VBox styleClass="tarjeta" spacing="16">
                    <Label text="Cambiar contrasena" styleClass="titulo-seccion"/>
                    <Separator styleClass="separador"/>
                    <HBox spacing="16">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="CONTRASENA ACTUAL" styleClass="etiqueta-campo"/>
                            <PasswordField fx:id="campoPasswordActual" styleClass="campo-texto" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="NUEVA CONTRASENA" styleClass="etiqueta-campo"/>
                            <PasswordField fx:id="campoPasswordNueva" styleClass="campo-texto" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="CONFIRMAR CONTRASENA" styleClass="etiqueta-campo"/>
                            <PasswordField fx:id="campoPasswordConfirmar" styleClass="campo-texto" maxWidth="Infinity"/>
                        </VBox>
                    </HBox>
                    <Button text="Cambiar contrasena" styleClass="btn-secundario" onAction="#cambiarPassword"/>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
