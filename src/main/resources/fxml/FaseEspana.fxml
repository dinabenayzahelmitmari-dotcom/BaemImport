<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.controller.FaseEspanaController"
            styleClass="fondo-principal"
            stylesheets="@../css/main.css">
    <left>
        <VBox styleClass="menu-lateral" spacing="4">
            <padding><Insets top="24" right="12" bottom="24" left="12"/></padding>
            <VBox alignment="CENTER_LEFT" spacing="2"><padding><Insets bottom="28"/></padding>
                <Label text="BAEMIMPORT" styleClass="menu-logo"/>
                <Label text="Importacion desde Alemania" styleClass="menu-logo-sub"/>
            </VBox>
            <Label text="MENU" style="-fx-font-size:10px; -fx-text-fill:#4f6ef7; -fx-padding:0 0 6 8;"/>
            <Button text="Dashboard"       styleClass="btn-nav" maxWidth="Infinity" onAction="#irDashboard"/>
            <Button text="Mis Vehiculos"   styleClass="btn-nav" maxWidth="Infinity" onAction="#irVehiculos"/>
            <Button text="Buscar Vehiculo" styleClass="btn-nav" maxWidth="Infinity" onAction="#irBusqueda"/>
            <Button text="Fase Alemania"   styleClass="btn-nav" maxWidth="Infinity" onAction="#irFaseAlemania"/>
            <Button text="Transporte"      styleClass="btn-nav" maxWidth="Infinity" onAction="#irTransporte"/>
            <Button text="Fase Espana" maxWidth="Infinity">
                <styleClass>
                    <String fx:value="btn-nav"/>
                    <String fx:value="btn-nav-activo"/>
                </styleClass>
            </Button>
            <Button text="Documentos"      styleClass="btn-nav" maxWidth="Infinity" onAction="#irDocumentos"/>
            <Separator styleClass="separador"/>
            <Button text="Mi Perfil"       styleClass="btn-nav" maxWidth="Infinity" onAction="#irPerfil"/>
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll-pane">
            <VBox spacing="24"><padding><Insets top="32" right="32" bottom="32" left="32"/></padding>

                <HBox alignment="CENTER_LEFT" spacing="12">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Fase Espana" styleClass="titulo-pagina"/>
                        <Label text="ITV, Hacienda y matriculacion en la DGT" styleClass="subtitulo"/>
                    </VBox>
                    <Label fx:id="lblProgreso" text="0 / 3 completados" styleClass="badge-pendiente"/>
                </HBox>

                <ProgressBar fx:id="barraProgreso" progress="0.0" styleClass="barra-progreso" maxWidth="Infinity"/>

                <!-- ITV -->
                <VBox styleClass="tarjeta" spacing="14">
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Label text="ITV — Inspeccion Tecnica de Vehiculos" styleClass="titulo-seccion" HBox.hgrow="ALWAYS"/>
                        <Label fx:id="badgeItv" text="Pendiente" styleClass="badge-pendiente"/>
                    </HBox>
                    <Separator styleClass="separador"/>
                    <HBox spacing="16">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="FECHA DE CITA ITV" styleClass="etiqueta-campo"/>
                            <DatePicker fx:id="fechaCitaItv" styleClass="campo-texto" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="PROVINCIA" styleClass="etiqueta-campo"/>
                            <ComboBox fx:id="comboProvincia" styleClass="combo-box" maxWidth="Infinity"/>
                        </VBox>
                    </HBox>
                    <HBox spacing="16" alignment="CENTER_LEFT">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <HBox spacing="12" alignment="CENTER_LEFT">
                                <CheckBox fx:id="chkFichaTecnica" text="Ficha tecnica subida" onAction="#actualizarProgreso"/>
                                <Label fx:id="estadoFichaTecnica" text="Pendiente" styleClass="badge-pendiente"/>
                            </HBox>
                            <CheckBox fx:id="chkItvSuperada" text="ITV superada" onAction="#actualizarProgreso"/>
                        </VBox>
                        <VBox spacing="6">
                            <Button text="Subir ficha tecnica" styleClass="btn-secundario" onAction="#subirFichaTecnica"/>
                            <Button text="Pedir cita ITV"      styleClass="btn-secundario" onAction="#abrirWebItv"/>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- Hacienda -->
                <VBox styleClass="tarjeta" spacing="14">
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Label text="Hacienda — Impuesto de Matriculacion" styleClass="titulo-seccion" HBox.hgrow="ALWAYS"/>
                        <Label fx:id="badgeHacienda" text="Pendiente" styleClass="badge-pendiente"/>
                    </HBox>
                    <Separator styleClass="separador"/>
                    <HBox spacing="16">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="PRECIO DE COMPRA (EUR)" styleClass="etiqueta-campo"/>
                            <TextField fx:id="campoPrecioCalculo" styleClass="campo-texto"
                                       promptText="Ej: 24000" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="EMISIONES CO2 (g/km)" styleClass="etiqueta-campo"/>
                            <TextField fx:id="campoEmisiones" styleClass="campo-texto"
                                       promptText="Ej: 145" maxWidth="Infinity"/>
                        </VBox>
                    </HBox>
                    <HBox spacing="12">
                        <Button text="Calcular impuestos" styleClass="btn-primario"  onAction="#calcularImpuesto"/>
                        <Button text="Descargar informe PDF" styleClass="btn-exito"  onAction="#descargarInformeImpuestos"/>
                        <Button text="Sede AEAT" styleClass="btn-secundario"         onAction="#abrirAeat"/>
                    </HBox>
                    <HBox spacing="32">
                        <VBox spacing="4">
                            <Label text="TIPO DE GRAVAMEN" styleClass="etiqueta-campo"/>
                            <Label fx:id="lblTipoGravamen" text="—" styleClass="texto-primario"/>
                        </VBox>
                        <VBox spacing="4">
                            <Label text="IMPUESTO MATRICULACION" styleClass="etiqueta-campo"/>
                            <Label fx:id="lblImpuestoMatriculacion" text="—" styleClass="texto-normal"/>
                        </VBox>
                        <VBox spacing="4">
                            <Label text="IMPUESTO CIRCULACION" styleClass="etiqueta-campo"/>
                            <Label fx:id="lblImpuestoCirculacion" text="—" styleClass="texto-normal"/>
                        </VBox>
                    </HBox>
                    <CheckBox fx:id="chkHaciendaPagada" text="Impuesto de matriculacion pagado" onAction="#actualizarProgreso"/>
                </VBox>

                <!-- DGT -->
                <VBox styleClass="tarjeta" spacing="14">
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Label text="DGT — Matriculacion definitiva" styleClass="titulo-seccion" HBox.hgrow="ALWAYS"/>
                        <Label fx:id="badgeDgt" text="Pendiente" styleClass="badge-pendiente"/>
                    </HBox>
                    <Separator styleClass="separador"/>
                    <HBox spacing="16" alignment="CENTER_LEFT">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="ESTADO DEL TRAMITE DGT" styleClass="etiqueta-campo"/>
                            <ComboBox fx:id="comboEstadoDgt" styleClass="combo-box" maxWidth="Infinity"
                                      onAction="#actualizarProgreso"/>
                        </VBox>
                        <VBox spacing="6">
                            <HBox spacing="12" alignment="CENTER_LEFT">
                                <CheckBox fx:id="chkDocDgt" text="Documentacion DGT subida" onAction="#actualizarProgreso"/>
                                <Label fx:id="estadoDocDgt" text="Pendiente" styleClass="badge-pendiente"/>
                            </HBox>
                        </VBox>
                    </HBox>
                    <HBox spacing="12">
                        <Button text="Guardar estado DGT" styleClass="btn-primario"   onAction="#guardarEstadoDgt"/>
                        <Button text="Subir docs DGT"     styleClass="btn-secundario" onAction="#subirDocsDgt"/>
                        <Button text="Sede DGT"           styleClass="btn-secundario" onAction="#abrirDgt"/>
                    </HBox>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
