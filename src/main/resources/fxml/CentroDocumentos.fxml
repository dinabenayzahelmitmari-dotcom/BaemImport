<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<!-- Centro de Documentos: gestión y visualización de todos los archivos por vehículo -->
<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.controller.CentroDocumentosController"
            styleClass="fondo-principal"
            stylesheets="@../css/main.css">

    <left>
        <VBox styleClass="menu-lateral" spacing="4">
            <padding><Insets top="24" right="12" bottom="24" left="12"/></padding>
            <Label text="🚗 BAEMIMPORT" styleClass="menu-logo"/>
            <Label text="Importación desde Alemania" styleClass="menu-logo-sub"/>
            <Label text="MENÚ" style="-fx-font-size:10px; -fx-text-fill:#4f6ef7; -fx-padding:0 0 6 8;"/>
            <Button text="📊  Dashboard"        styleClass="btn-nav" maxWidth="Infinity" onAction="#irDashboard"/>
            <Button text="🚙  Mis Vehículos"    styleClass="btn-nav" maxWidth="Infinity" onAction="#irVehiculos"/>
            <Button text="🔍  Buscar Vehículo"  styleClass="btn-nav" maxWidth="Infinity" onAction="#irBusqueda"/>
            <Button text="🇩🇪  Fase Alemania"   styleClass="btn-nav" maxWidth="Infinity" onAction="#irFaseAlemania"/>
            <Button text="🚛  Transporte"        styleClass="btn-nav" maxWidth="Infinity" onAction="#irTransporte"/>
            <Button text="🇪🇸  Fase España"     styleClass="btn-nav" maxWidth="Infinity" onAction="#irFaseEspana"/>
            <Button text="📁  Documentos"        styleClass="btn-nav, btn-nav-activo" maxWidth="Infinity"/>
            <Separator styleClass="separador"/>
            <Button text="👤  Mi Perfil"         styleClass="btn-nav" maxWidth="Infinity" onAction="#irPerfil"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="0">

            <!-- Cabecera -->
            <HBox styleClass="tarjeta" alignment="CENTER_LEFT" spacing="16"
                  style="-fx-background-radius:0; -fx-border-radius:0;">
                <padding><Insets top="20" right="32" bottom="20" left="32"/></padding>
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="📁  Centro de Documentos" styleClass="titulo-pagina"/>
                    <Label text="Todos tus documentos organizados por vehículo y fase" styleClass="subtitulo"/>
                </VBox>
                <Button text="📎 Subir nuevo documento" styleClass="btn-primario" onAction="#subirNuevoDocumento"/>
            </HBox>

            <!-- Filtros -->
            <HBox spacing="12" style="-fx-background-color:#1a1d27; -fx-padding:12 32;">
                <TextField fx:id="campoBusquedaDoc" styleClass="campo-texto"
                           promptText="🔍 Buscar documento..." HBox.hgrow="ALWAYS"
                           onKeyReleased="#filtrarDocumentos"/>
                <ComboBox fx:id="comboFiltroFase" styleClass="combo-box"
                          promptText="Filtrar por fase" prefWidth="160"
                          onAction="#filtrarDocumentos"/>
                <ComboBox fx:id="comboFiltroTipo" styleClass="combo-box"
                          promptText="Tipo de archivo" prefWidth="140"
                          onAction="#filtrarDocumentos"/>
                <Button text="🔄 Limpiar" styleClass="btn-secundario" onAction="#limpiarFiltros"/>
            </HBox>

            <!-- Tabla de documentos -->
            <VBox VBox.vgrow="ALWAYS" style="-fx-padding:16 32;">
                <TableView fx:id="tablaDocumentos" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colNombre"   text="Nombre"        prefWidth="220"/>
                        <TableColumn fx:id="colFase"     text="Fase"          prefWidth="120"/>
                        <TableColumn fx:id="colTipo"     text="Tipo"          prefWidth="80"/>
                        <TableColumn fx:id="colVehiculo" text="Vehículo"      prefWidth="160"/>
                        <TableColumn fx:id="colFecha"    text="Fecha subida"  prefWidth="120"/>
                        <TableColumn fx:id="colEstado"   text="Estado"        prefWidth="110"/>
                    </columns>
                    <placeholder>
                        <Label text="Sin documentos subidos todavía" styleClass="texto-secundario"/>
                    </placeholder>
                </TableView>

                <!-- Acciones sobre documento seleccionado -->
                <HBox spacing="12" style="-fx-padding:12 0 0 0;">
                    <Button text="👁️ Ver"           styleClass="btn-secundario" onAction="#verDocumento"/>
                    <Button text="⬇️ Descargar"     styleClass="btn-secundario" onAction="#descargarDocumento"/>
                    <Button text="🗑️ Eliminar"      styleClass="btn-peligro"    onAction="#eliminarDocumento"/>
                    <Label fx:id="lblInfoSeleccion" styleClass="texto-secundario"
                           style="-fx-padding:0 0 0 12;" HBox.hgrow="ALWAYS"/>
                </HBox>
            </VBox>

        </VBox>
    </center>

</BorderPane>
