<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<!-- Búsqueda de Vehículo: formulario de preferencias del cliente -->
<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.controller.BusquedaVehiculoController"
            styleClass="fondo-principal"
            stylesheets="@../css/main.css">

    <left>
        <VBox styleClass="menu-lateral" spacing="4">
            <padding><Insets top="24" right="12" bottom="24" left="12"/></padding>
            <Label text="🚗 BAEMIMPORT" styleClass="menu-logo"/>
            <Label text="Importación desde Alemania" styleClass="menu-logo-sub"/>
            <Label text="MENÚ" style="-fx-font-size:10px; -fx-text-fill:#4f6ef7; -fx-padding:0 0 6 8;"/>
            <Button text="📊  Dashboard"        styleClass="btn-nav" maxWidth="Infinity" onAction="#irDashboard"/>
            <Button text="🚙  Mis Vehículos"    styleClass="btn-nav" maxWidth="Infinity" onAction="#irVehiculos"/>
            <Button text="🔍  Buscar Vehículo"  styleClass="btn-nav, btn-nav-activo" maxWidth="Infinity"/>
            <Button text="🇩🇪  Fase Alemania"   styleClass="btn-nav" maxWidth="Infinity" onAction="#irFaseAlemania"/>
            <Button text="🚛  Transporte"        styleClass="btn-nav" maxWidth="Infinity" onAction="#irTransporte"/>
            <Button text="🇪🇸  Fase España"     styleClass="btn-nav" maxWidth="Infinity" onAction="#irFaseEspana"/>
            <Button text="📁  Documentos"        styleClass="btn-nav" maxWidth="Infinity" onAction="#irDocumentos"/>
            <Separator styleClass="separador"/>
            <Button text="👤  Mi Perfil"         styleClass="btn-nav" maxWidth="Infinity" onAction="#irPerfil"/>
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll-pane">
            <VBox spacing="24">
                <padding><Insets top="32" right="32" bottom="32" left="32"/></padding>

                <!-- Cabecera -->
                <VBox spacing="4">
                    <Label text="🔍  Buscar Vehículo" styleClass="titulo-pagina"/>
                    <Label text="Define las características del coche que quieres importar desde Alemania" styleClass="subtitulo"/>
                </VBox>

                <!-- Formulario de preferencias -->
                <VBox styleClass="tarjeta" spacing="20">
                    <Label text="Características del vehículo" styleClass="titulo-seccion"/>
                    <Separator styleClass="separador"/>

                    <!-- Marca y modelo -->
                    <HBox spacing="16">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="MARCA DESEADA" styleClass="etiqueta-campo"/>
                            <ComboBox fx:id="comboMarca" styleClass="combo-box"
                                      promptText="Ej: BMW" editable="true" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="MODELO" styleClass="etiqueta-campo"/>
                            <TextField fx:id="campoModelo" styleClass="campo-texto"
                                       promptText="Ej: Serie 3, Golf, A4..." maxWidth="Infinity"/>
                        </VBox>
                    </HBox>

                    <!-- Año y precio -->
                    <HBox spacing="16">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="AÑO MÍNIMO" styleClass="etiqueta-campo"/>
                            <TextField fx:id="campoAnioMin" styleClass="campo-texto"
                                       promptText="Ej: 2018" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="PRECIO MÁXIMO (€)" styleClass="etiqueta-campo"/>
                            <TextField fx:id="campoPrecioMax" styleClass="campo-texto"
                                       promptText="Ej: 30000" maxWidth="Infinity"/>
                        </VBox>
                    </HBox>

                    <!-- Km y potencia -->
                    <HBox spacing="16">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="KILÓMETROS MÁXIMOS" styleClass="etiqueta-campo"/>
                            <TextField fx:id="campoKmMax" styleClass="campo-texto"
                                       promptText="Ej: 100000" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="POTENCIA APROXIMADA (CV)" styleClass="etiqueta-campo"/>
                            <TextField fx:id="campoPotencia" styleClass="campo-texto"
                                       promptText="Ej: 150" maxWidth="Infinity"/>
                        </VBox>
                    </HBox>

                    <!-- Combustible -->
                    <VBox spacing="6">
                        <Label text="TIPO DE COMBUSTIBLE" styleClass="etiqueta-campo"/>
                        <HBox spacing="12">
                            <CheckBox fx:id="chkGasolina"  text="⛽  Gasolina"  styleClass="texto-normal"/>
                            <CheckBox fx:id="chkDiesel"    text="🛢️  Diésel"    styleClass="texto-normal"/>
                            <CheckBox fx:id="chkHibrido"   text="⚡🛢️  Híbrido"  styleClass="texto-normal"/>
                            <CheckBox fx:id="chkElectrico" text="⚡  Eléctrico" styleClass="texto-normal"/>
                            <CheckBox fx:id="chkGas"       text="🔵  Gas"       styleClass="texto-normal"/>
                        </HBox>
                    </VBox>
                </VBox>

                <!-- Extras deseados -->
                <VBox styleClass="tarjeta" spacing="16">
                    <Label text="✨  Extras deseados" styleClass="titulo-seccion"/>
                    <Separator styleClass="separador"/>

                    <GridPane hgap="16" vgap="10">
                        <CheckBox fx:id="chkNavegador"        text="🗺️  Navegador GPS"       GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="texto-normal"/>
                        <CheckBox fx:id="chkCamaraTrasera"    text="📷  Cámara trasera"       GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="texto-normal"/>
                        <CheckBox fx:id="chkSensorAparcamiento" text="🔊  Sensores aparcamiento" GridPane.columnIndex="2" GridPane.rowIndex="0" styleClass="texto-normal"/>
                        <CheckBox fx:id="chkLlavedePuerta"    text="🔑  Entrada sin llave"    GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="texto-normal"/>
                        <CheckBox fx:id="chkTechoSolar"       text="☀️  Techo solar"          GridPane.columnIndex="1" GridPane.rowIndex="1" styleClass="texto-normal"/>
                        <CheckBox fx:id="chkAsientosCalef"    text="🔥  Asientos calefactados" GridPane.columnIndex="2" GridPane.rowIndex="1" styleClass="texto-normal"/>
                        <CheckBox fx:id="chkCarPlay"          text="📱  CarPlay / Android Auto" GridPane.columnIndex="0" GridPane.rowIndex="2" styleClass="texto-normal"/>
                        <CheckBox fx:id="chkLedMatrix"        text="💡  Faros LED/Matrix"     GridPane.columnIndex="1" GridPane.rowIndex="2" styleClass="texto-normal"/>
                        <CheckBox fx:id="chkPilotoAutomatico" text="🤖  Piloto automático"    GridPane.columnIndex="2" GridPane.rowIndex="2" styleClass="texto-normal"/>
                    </GridPane>
                </VBox>

                <!-- Ubicación y notas -->
                <VBox styleClass="tarjeta" spacing="14">
                    <Label text="📍  Ubicación y notas" styleClass="titulo-seccion"/>
                    <Separator styleClass="separador"/>

                    <VBox spacing="6">
                        <Label text="REGIÓN PREFERIDA EN ALEMANIA" styleClass="etiqueta-campo"/>
                        <ComboBox fx:id="comboRegion" styleClass="combo-box"
                                  promptText="Cualquier región" maxWidth="Infinity"/>
                    </VBox>

                    <VBox spacing="6">
                        <Label text="NOTAS ADICIONALES" styleClass="etiqueta-campo"/>
                        <TextArea fx:id="campoNotas" styleClass="campo-texto"
                                  promptText="Describe cualquier preferencia adicional..."
                                  prefRowCount="3" wrapText="true"/>
                    </VBox>
                </VBox>

                <!-- Mensaje de estado -->
                <Label fx:id="lblMensaje" styleClass="texto-secundario" wrapText="true"/>

                <!-- Acciones -->
                <HBox spacing="12" alignment="CENTER_RIGHT">
                    <Button text="🗑️ Limpiar" styleClass="btn-secundario" onAction="#limpiarFormulario"/>
                    <Button text="💾 Guardar preferencias" styleClass="btn-primario" onAction="#guardarPreferencias"/>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
