<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.controller.FaseAlemaniaController"
            styleClass="fondo-principal"
            stylesheets="@../css/main.css">
    <left>
        <VBox styleClass="menu-lateral" spacing="4">
            <padding><Insets top="24" right="12" bottom="24" left="12"/></padding>
            <VBox alignment="CENTER_LEFT" spacing="2"><padding><Insets bottom="28"/></padding>
                <Label text="BAEMIMPORT" styleClass="menu-logo"/>
                <Label text="Importacion desde Alemania" styleClass="menu-logo-sub"/>
            </VBox>
            <Label text="MENU" style="-fx-font-size:10px; -fx-text-fill:#4f6ef7; -fx-padding:0 0 6 8;"/>
            <Button text="Dashboard"       styleClass="btn-nav" maxWidth="Infinity" onAction="#irDashboard"/>
            <Button text="Mis Vehiculos"   styleClass="btn-nav" maxWidth="Infinity" onAction="#irVehiculos"/>
            <Button text="Buscar Vehiculo" styleClass="btn-nav" maxWidth="Infinity" onAction="#irBusqueda"/>
            <Button text="Fase Alemania" maxWidth="Infinity">
                <styleClass>
                    <String fx:value="btn-nav"/>
                    <String fx:value="btn-nav-activo"/>
                </styleClass>
            </Button>
            <Button text="Transporte"      styleClass="btn-nav" maxWidth="Infinity" onAction="#irTransporte"/>
            <Button text="Fase Espana"     styleClass="btn-nav" maxWidth="Infinity" onAction="#irFaseEspana"/>
            <Button text="Documentos"      styleClass="btn-nav" maxWidth="Infinity" onAction="#irDocumentos"/>
            <Separator styleClass="separador"/>
            <Button text="Mi Perfil"       styleClass="btn-nav" maxWidth="Infinity" onAction="#irPerfil"/>
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll-pane">
            <VBox spacing="24"><padding><Insets top="32" right="32" bottom="32" left="32"/></padding>

                <HBox alignment="CENTER_LEFT" spacing="12">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Fase Alemania" styleClass="titulo-pagina"/>
                        <Label text="Documentacion y gestion en origen" styleClass="subtitulo"/>
                    </VBox>
                    <Label fx:id="lblProgreso" text="0 / 6 completados" styleClass="badge-pendiente"/>
                </HBox>

                <ProgressBar fx:id="barraProgreso" progress="0.0" styleClass="barra-progreso" maxWidth="Infinity"/>

                <!-- Checklist documentos -->
                <VBox styleClass="tarjeta" spacing="14">
                    <Label text="Documentos obligatorios" styleClass="titulo-seccion"/>
                    <Separator styleClass="separador"/>

                    <HBox spacing="16">
                        <VBox spacing="10" HBox.hgrow="ALWAYS">
                            <HBox spacing="12" alignment="CENTER_LEFT">
                                <CheckBox fx:id="chkFactura" text="Factura de compra" onAction="#actualizarProgreso" HBox.hgrow="ALWAYS"/>
                                <Label fx:id="estadoFactura" text="Pendiente" styleClass="badge-pendiente"/>
                                <Button text="Subir" styleClass="btn-secundario" onAction="#subirFactura"/>
                            </HBox>
                            <HBox spacing="12" alignment="CENTER_LEFT">
                                <CheckBox fx:id="chkTail1" text="Tail 1 (titulo del vehiculo)" onAction="#actualizarProgreso" HBox.hgrow="ALWAYS"/>
                                <Label fx:id="estadoTail1" text="Pendiente" styleClass="badge-pendiente"/>
                                <Button text="Subir" styleClass="btn-secundario" onAction="#subirTail1"/>
                            </HBox>
                            <HBox spacing="12" alignment="CENTER_LEFT">
                                <CheckBox fx:id="chkTail2" text="Tail 2 (certificado de matriculacion)" onAction="#actualizarProgreso" HBox.hgrow="ALWAYS"/>
                                <Label fx:id="estadoTail2" text="Pendiente" styleClass="badge-pendiente"/>
                                <Button text="Subir" styleClass="btn-secundario" onAction="#subirTail2"/>
                            </HBox>
                            <HBox spacing="12" alignment="CENTER_LEFT">
                                <CheckBox fx:id="chkCoc" text="COC — Certificado de Conformidad" onAction="#actualizarProgreso" HBox.hgrow="ALWAYS"/>
                                <Label fx:id="estadoCoc" text="Pendiente" styleClass="badge-pendiente"/>
                                <Button text="Subir" styleClass="btn-secundario" onAction="#subirCoc"/>
                            </HBox>
                            <HBox spacing="12" alignment="CENTER_LEFT">
                                <CheckBox fx:id="chkSeguroMatriculas" text="Seguro de matriculas de traslado" onAction="#actualizarProgreso" HBox.hgrow="ALWAYS"/>
                                <Label fx:id="estadoSeguroMatriculas" text="Pendiente" styleClass="badge-pendiente"/>
                                <Button text="Subir" styleClass="btn-secundario" onAction="#subirSeguroMatriculas"/>
                            </HBox>
                            <HBox spacing="12" alignment="CENTER_LEFT">
                                <CheckBox fx:id="chkTuv" text="TUV — Inspeccion tecnica alemana" onAction="#actualizarProgreso" HBox.hgrow="ALWAYS"/>
                                <Label fx:id="estadoTuv" text="Pendiente" styleClass="badge-pendiente"/>
                                <Button text="Subir" styleClass="btn-secundario" onAction="#subirTuv"/>
                            </HBox>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- Tipo de matricula -->
                <VBox styleClass="tarjeta" spacing="14">
                    <Label text="Tipo de matricula de traslado" styleClass="titulo-seccion"/>
                    <Separator styleClass="separador"/>
                    <HBox spacing="24" alignment="CENTER_LEFT">
                        <RadioButton fx:id="radioRoja"     text="Matricula roja (exportacion)" onAction="#guardarMatricula"/>
                        <RadioButton fx:id="radioAmarilla" text="Matricula amarilla (traslado propio)" onAction="#guardarMatricula"/>
                        <Label fx:id="lblTipoMatricula" text="Sin seleccionar" styleClass="badge-pendiente"/>
                    </HBox>
                    <Button text="Confirmar tipo de matricula" styleClass="btn-primario" onAction="#guardarMatricula"/>
                </VBox>

                <!-- Plantilla de preguntas al vendedor -->
                <VBox styleClass="tarjeta" spacing="14">
                    <Label text="Plantilla de preguntas al vendedor" styleClass="titulo-seccion"/>
                    <Separator styleClass="separador"/>
                    <TextArea fx:id="areaPreguntas" styleClass="campo-texto" prefRowCount="10" wrapText="true"/>
                    <HBox spacing="12">
                        <Button text="Copiar al portapapeles" styleClass="btn-secundario"  onAction="#copiarPreguntas"/>
                        <Button text="Enviar por email"       styleClass="btn-primario"    onAction="#enviarEmail"/>
                        <Button text="Enviar por WhatsApp"    styleClass="btn-secundario"  onAction="#enviarWhatsapp"/>
                        <Button text="Restaurar plantilla"    styleClass="btn-secundario"  onAction="#restaurarPlantilla"/>
                    </HBox>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
