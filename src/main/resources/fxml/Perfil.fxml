<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<!-- Perfil de usuario: datos personales y fiscales para autocompletar formularios -->
<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.controller.PerfilController"
            styleClass="fondo-principal"
            stylesheets="@../css/main.css">

    <left>
        <VBox styleClass="menu-lateral" spacing="4">
            <padding><Insets top="24" right="12" bottom="24" left="12"/></padding>
            <Label text="🚗 BAEMIMPORT" styleClass="menu-logo"/>
            <Label text="Importación desde Alemania" styleClass="menu-logo-sub"/>
            <Label text="MENÚ" style="-fx-font-size:10px; -fx-text-fill:#4f6ef7; -fx-padding:0 0 6 8;"/>
            <Button text="📊  Dashboard"        styleClass="btn-nav" maxWidth="Infinity" onAction="#irDashboard"/>
            <Button text="🚙  Mis Vehículos"    styleClass="btn-nav" maxWidth="Infinity" onAction="#irVehiculos"/>
            <Button text="🔍  Buscar Vehículo"  styleClass="btn-nav" maxWidth="Infinity" onAction="#irBusqueda"/>
            <Button text="🇩🇪  Fase Alemania"   styleClass="btn-nav" maxWidth="Infinity" onAction="#irFaseAlemania"/>
            <Button text="🚛  Transporte"        styleClass="btn-nav" maxWidth="Infinity" onAction="#irTransporte"/>
            <Button text="🇪🇸  Fase España"     styleClass="btn-nav" maxWidth="Infinity" onAction="#irFaseEspana"/>
            <Button text="📁  Documentos"        styleClass="btn-nav" maxWidth="Infinity" onAction="#irDocumentos"/>
            <Separator styleClass="separador"/>
            <Button text="👤  Mi Perfil"         styleClass="btn-nav, btn-nav-activo" maxWidth="Infinity"/>
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll-pane">
            <VBox spacing="24">
                <padding><Insets top="32" right="32" bottom="32" left="32"/></padding>

                <!-- Cabecera -->
                <HBox alignment="CENTER_LEFT" spacing="16">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="👤  Mi Perfil" styleClass="titulo-pagina"/>
                        <Label text="Tus datos se usarán para autocompletar formularios de importación" styleClass="subtitulo"/>
                    </VBox>
                </HBox>

                <!-- Datos personales -->
                <VBox styleClass="tarjeta" spacing="16">
                    <Label text="🧾  Datos personales" styleClass="titulo-seccion"/>
                    <Separator styleClass="separador"/>

                    <HBox spacing="16">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="NOMBRE COMPLETO" styleClass="etiqueta-campo"/>
                            <TextField fx:id="campoNombre" styleClass="campo-texto"
                                       promptText="Nombre y apellidos" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="DNI / NIE / NIF" styleClass="etiqueta-campo"/>
                            <TextField fx:id="campoDni" styleClass="campo-texto"
                                       promptText="Ej: 12345678A" maxWidth="Infinity"/>
                        </VBox>
                    </HBox>

                    <HBox spacing="16">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="EMAIL" styleClass="etiqueta-campo"/>
                            <TextField fx:id="campoEmail" styleClass="campo-texto"
                                       promptText="correo@email.com" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="TELÉFONO" styleClass="etiqueta-campo"/>
                            <TextField fx:id="campoTelefono" styleClass="campo-texto"
                                       promptText="+34 600 000 000" maxWidth="Infinity"/>
                        </VBox>
                    </HBox>

                    <VBox spacing="6">
                        <Label text="FECHA DE NACIMIENTO" styleClass="etiqueta-campo"/>
                        <DatePicker fx:id="fechaNacimiento" styleClass="campo-texto"
                                    promptText="dd/MM/yyyy" maxWidth="300"/>
                    </VBox>
                </VBox>

                <!-- Dirección -->
                <VBox styleClass="tarjeta" spacing="16">
                    <Label text="📍  Dirección" styleClass="titulo-seccion"/>
                    <Separator styleClass="separador"/>

                    <VBox spacing="6">
                        <Label text="DIRECCIÓN (Calle, número, piso)" styleClass="etiqueta-campo"/>
                        <TextField fx:id="campoDireccion" styleClass="campo-texto"
                                   promptText="Ej: Calle Mayor, 5, 2ºA" maxWidth="Infinity"/>
                    </VBox>

                    <HBox spacing="16">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="CIUDAD" styleClass="etiqueta-campo"/>
                            <TextField fx:id="campoCiudad" styleClass="campo-texto"
                                       promptText="Ej: Madrid" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="6">
                            <Label text="CÓDIGO POSTAL" styleClass="etiqueta-campo"/>
                            <TextField fx:id="campoCp" styleClass="campo-texto"
                                       promptText="Ej: 28001" prefWidth="130"/>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="PROVINCIA" styleClass="etiqueta-campo"/>
                            <TextField fx:id="campoProvincia" styleClass="campo-texto"
                                       promptText="Ej: Madrid" maxWidth="Infinity"/>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- Datos fiscales -->
                <VBox styleClass="tarjeta" spacing="16">
                    <Label text="🏛️  Datos fiscales" styleClass="titulo-seccion"/>
                    <Separator styleClass="separador"/>
                    <Label text="Usados en formularios de Hacienda y DGT" styleClass="texto-secundario"/>

                    <HBox spacing="16">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="ENTIDAD BANCARIA" styleClass="etiqueta-campo"/>
                            <TextField fx:id="campoBanco" styleClass="campo-texto"
                                       promptText="Ej: CaixaBank" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="IBAN" styleClass="etiqueta-campo"/>
                            <TextField fx:id="campoIban" styleClass="campo-texto"
                                       promptText="ES00 0000 0000 0000 0000 0000" maxWidth="Infinity"/>
                        </VBox>
                    </HBox>

                    <VBox spacing="6">
                        <Label text="DELEGACIÓN DE HACIENDA" styleClass="etiqueta-campo"/>
                        <TextField fx:id="campoDelegacionHacienda" styleClass="campo-texto"
                                   promptText="Ej: Delegación Madrid — Oficina Las Tablas" maxWidth="Infinity"/>
                    </VBox>
                </VBox>

                <!-- Cambio de contraseña -->
                <VBox styleClass="tarjeta" spacing="16">
                    <Label text="🔒  Seguridad" styleClass="titulo-seccion"/>
                    <Separator styleClass="separador"/>

                    <HBox spacing="16">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="CONTRASEÑA ACTUAL" styleClass="etiqueta-campo"/>
                            <PasswordField fx:id="campoPasswordActual" styleClass="campo-texto"
                                           promptText="••••••••" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="NUEVA CONTRASEÑA" styleClass="etiqueta-campo"/>
                            <PasswordField fx:id="campoPasswordNueva" styleClass="campo-texto"
                                           promptText="••••••••" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="CONFIRMAR CONTRASEÑA" styleClass="etiqueta-campo"/>
                            <PasswordField fx:id="campoPasswordConfirmar" styleClass="campo-texto"
                                           promptText="••••••••" maxWidth="Infinity"/>
                        </VBox>
                    </HBox>

                    <Button text="🔑 Cambiar contraseña" styleClass="btn-secundario"
                            onAction="#cambiarPassword"/>
                </VBox>

                <!-- Mensaje de estado -->
                <Label fx:id="lblMensaje" styleClass="texto-secundario" wrapText="true"/>

                <!-- Acciones -->
                <HBox spacing="12" alignment="CENTER_RIGHT">
                    <Button text="🔄 Restaurar" styleClass="btn-secundario" onAction="#cargarDatos"/>
                    <Button text="💾 Guardar perfil" styleClass="btn-primario" onAction="#guardarPerfil"/>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
