<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.controller.BusquedaVehiculoController"
            styleClass="fondo-principal"
            stylesheets="@../css/main.css">
    <left>
        <VBox styleClass="menu-lateral" spacing="4">
            <padding><Insets top="24" right="12" bottom="24" left="12"/></padding>
            <VBox alignment="CENTER_LEFT" spacing="2"><padding><Insets bottom="28"/></padding>
                <Label text="BAEMIMPORT" styleClass="menu-logo"/>
                <Label text="Importacion desde Alemania" styleClass="menu-logo-sub"/>
            </VBox>
            <Label text="MENU" style="-fx-font-size:10px; -fx-text-fill:#4f6ef7; -fx-padding:0 0 6 8;"/>
            <Button text="Dashboard"       styleClass="btn-nav" maxWidth="Infinity" onAction="#irDashboard"/>
            <Button text="Mis Vehiculos"   styleClass="btn-nav" maxWidth="Infinity" onAction="#irVehiculos"/>
            <Button text="Buscar Vehiculo" maxWidth="Infinity">
                <styleClass>
                    <String fx:value="btn-nav"/>
                    <String fx:value="btn-nav-activo"/>
                </styleClass>
            </Button>
            <Button text="Fase Alemania"   styleClass="btn-nav" maxWidth="Infinity" onAction="#irFaseAlemania"/>
            <Button text="Transporte"      styleClass="btn-nav" maxWidth="Infinity" onAction="#irTransporte"/>
            <Button text="Fase Espana"     styleClass="btn-nav" maxWidth="Infinity" onAction="#irFaseEspana"/>
            <Button text="Documentos"      styleClass="btn-nav" maxWidth="Infinity" onAction="#irDocumentos"/>
            <Separator styleClass="separador"/>
            <Button text="Mi Perfil"       styleClass="btn-nav" maxWidth="Infinity" onAction="#irPerfil"/>
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll-pane">
            <VBox spacing="24"><padding><Insets top="32" right="32" bottom="32" left="32"/></padding>

                <HBox alignment="CENTER_LEFT">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Buscar Vehiculo" styleClass="titulo-pagina"/>
                        <Label text="Define tus criterios de busqueda para el mercado aleman" styleClass="subtitulo"/>
                    </VBox>
                </HBox>

                <!-- Filtros basicos -->
                <VBox styleClass="tarjeta" spacing="16">
                    <Label text="Criterios basicos" styleClass="titulo-seccion"/>
                    <Separator styleClass="separador"/>
                    <HBox spacing="16">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="MARCA" styleClass="etiqueta-campo"/>
                            <ComboBox fx:id="comboMarca" styleClass="combo-box" promptText="Seleccionar marca" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="MODELO" styleClass="etiqueta-campo"/>
                            <TextField fx:id="campoModelo" styleClass="campo-texto" promptText="Ej: Serie 3, Passat..." maxWidth="Infinity"/>
                        </VBox>
                    </HBox>
                    <HBox spacing="16">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="ANO MINIMO" styleClass="etiqueta-campo"/>
                            <TextField fx:id="campoAnioMin" styleClass="campo-texto" promptText="Ej: 2019" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="PRECIO MAXIMO (EUR)" styleClass="etiqueta-campo"/>
                            <TextField fx:id="campoPrecioMax" styleClass="campo-texto" promptText="Ej: 30000" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="KM MAXIMOS" styleClass="etiqueta-campo"/>
                            <TextField fx:id="campoKmMax" styleClass="campo-texto" promptText="Ej: 80000" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="POTENCIA MINIMA (CV)" styleClass="etiqueta-campo"/>
                            <TextField fx:id="campoPotencia" styleClass="campo-texto" promptText="Ej: 150" maxWidth="Infinity"/>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- Combustible -->
                <VBox styleClass="tarjeta" spacing="14">
                    <Label text="Tipo de combustible" styleClass="titulo-seccion"/>
                    <Separator styleClass="separador"/>
                    <HBox spacing="24">
                        <CheckBox fx:id="chkGasolina"  text="Gasolina"/>
                        <CheckBox fx:id="chkDiesel"    text="Diesel"/>
                        <CheckBox fx:id="chkHibrido"   text="Hibrido"/>
                        <CheckBox fx:id="chkElectrico" text="Electrico"/>
                        <CheckBox fx:id="chkGas"       text="Gas (GLP/GNC)"/>
                    </HBox>
                </VBox>

                <!-- Extras -->
                <VBox styleClass="tarjeta" spacing="14">
                    <Label text="Equipamiento y extras deseados" styleClass="titulo-seccion"/>
                    <Separator styleClass="separador"/>
                    <HBox spacing="32">
                        <VBox spacing="10">
                            <CheckBox fx:id="chkNavegador"          text="Navegador GPS"/>
                            <CheckBox fx:id="chkCamaraTrasera"      text="Camara trasera"/>
                            <CheckBox fx:id="chkSensorAparcamiento" text="Sensores de aparcamiento"/>
                            <CheckBox fx:id="chkLlavedePuerta"      text="Entrada sin llave"/>
                            <CheckBox fx:id="chkTechoSolar"         text="Techo solar"/>
                        </VBox>
                        <VBox spacing="10">
                            <CheckBox fx:id="chkAsientosCalef"   text="Asientos calefactados"/>
                            <CheckBox fx:id="chkCarPlay"         text="CarPlay / Android Auto"/>
                            <CheckBox fx:id="chkLedMatrix"       text="Faros LED / Matrix"/>
                            <CheckBox fx:id="chkPilotoAutomatico" text="Piloto automatico"/>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- Region y notas -->
                <VBox styleClass="tarjeta" spacing="14">
                    <Label text="Region y notas" styleClass="titulo-seccion"/>
                    <Separator styleClass="separador"/>
                    <VBox spacing="6">
                        <Label text="REGION DE BUSQUEDA EN ALEMANIA" styleClass="etiqueta-campo"/>
                        <ComboBox fx:id="comboRegion" styleClass="combo-box" maxWidth="400"/>
                    </VBox>
                    <VBox spacing="6">
                        <Label text="NOTAS ADICIONALES" styleClass="etiqueta-campo"/>
                        <TextArea fx:id="campoNotas" styleClass="campo-texto" prefRowCount="4"
                                  wrapText="true" promptText="Cualquier requisito especial..."/>
                    </VBox>
                    <Label fx:id="lblMensaje" text="" styleClass="texto-normal"/>
                    <HBox spacing="12">
                        <Button text="Guardar preferencias" styleClass="btn-primario"   onAction="#guardarPreferencias"/>
                        <Button text="Limpiar formulario"   styleClass="btn-secundario" onAction="#limpiarFormulario"/>
                    </HBox>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
